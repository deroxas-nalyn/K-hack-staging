---
import type { ImageMetadata } from "astro";
import defaultImage from "../assets/services/default.svg";
import Card from "./Card.astro";
import SectionTitle from "./SectionTitle.astro";

interface Service {
	title: string;
	description: string;
	features: string[];
	imageFilename?: string;
}

// 動的インポートのための型定義
const images = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/services/*.{png,jpg,jpeg,svg}",
);

const getServiceImage = async (service: Service): Promise<ImageMetadata> => {
	if (service.imageFilename) {
		const imagePath = `../assets/services/${service.imageFilename}`;
		if (imagePath in images) {
			const module = await images[imagePath]();
			return module.default;
		}
	}
	return defaultImage;
};

const services: Service[] = [
	{
		title: "システムインテグレーション事業",
		description:
			"国内大手企業向けの高品質なシステム開発とコンサルティングサービスを提供します。",
		features: [
			"基幹システムの開発・保守",
			"Webアプリケーション開発",
			"モバイルアプリケーション開発",
			"クラウドインテグレーション",
		],
		imageFilename: "integration.jpg",
	},
	{
		title: "地域DX支援事業",
		description:
			"地域企業のデジタルトランスフォーメーションを包括的にサポートします。",
		features: [
			"DXコンサルティング",
			"業務改善ソリューション",
			"デジタル化支援",
			"クラウド導入支援",
		],
		imageFilename: "dx.jpg",
	},
	{
		title: "人材育成事業",
		description: "最先端の技術と地域のニーズを結ぶIT人材を育成します。",
		features: [
			"IT人材育成プログラム",
			"DX人材教育支援",
			"技術研究・情報発信",
			"地域人材のスキルアップ支援",
		],
		imageFilename: "training.jpg",
	},
];

const serviceImages = await Promise.all(
	services.map((service) => getServiceImage(service)),
);
---

<section id="services" class="section-shell border-y border-black/8 bg-brand-panel/70">
  <div class="site-shell">
    <SectionTitle eyebrow="SERVICES">事業内容</SectionTitle>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
      {services.map((service, index) => (
        <Card
          title={service.title}
          description={service.description}
          imageUrl={serviceImages[index]}
          type="services"
        >
          <div class="space-y-3">
            <p class="text-xs font-bold uppercase tracking-[0.24em] text-brand-stone">
              主な内容
            </p>
            {service.features.map(feature => (
              <div class="flex items-start gap-3 border-t border-black/6 pt-3">
                <div class="mt-1.5 h-2.5 w-2.5 rotate-45 bg-brand-red"></div>
                <span class="text-sm leading-7 text-brand-ink-muted">{feature}</span>
              </div>
            ))}
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>
