---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultImage from "../assets/about/default.svg";
import Card from "./Card.astro";
import SectionTitle from "./SectionTitle.astro";

interface AboutSection {
	title: string;
	description: string;
	linkUrl: string;
	imageFilename?: string;
	isExternal?: boolean;
}

// 動的インポートのための型定義
const images = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/about/*.{png,jpg,jpeg,svg}",
);

const getAboutImage = async (section: AboutSection): Promise<ImageMetadata> => {
	try {
		if (section.imageFilename) {
			const imagePath = `../assets/about/${section.imageFilename}`;
			if (imagePath in images) {
				const module = await images[imagePath]();
				return module.default;
			}
		}
		return defaultImage;
	} catch (error) {
		console.error(`Failed to load image for section ${section.title}:`, error);
		return defaultImage;
	}
};

const sections: AboutSection[] = [
	{
		title: "会社概要",
		description: "会社概要や事業内容をご覧いただけます。",
		linkUrl: "/about",
		isExternal: false,
		imageFilename: "company.jpg",
	},
	{
		title: "採用情報",
		description: "募集職種や働く環境をご確認いただけます。",
		linkUrl: "https://herp.careers/v1/khack/",
		isExternal: true,
		imageFilename: "recruit.jpg",
	},
];

const sectionImages = await Promise.all(
	sections.map((section) => getAboutImage(section)),
);
---

<section
  id="about-us"
  class="section-shell"
  aria-labelledby="about-title"
>
  <div class="site-shell">
    <SectionTitle id="about-title" eyebrow="COMPANY">企業情報</SectionTitle>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        sections.map((section, index) => (
          <div
            class="group hover:-translate-y-1 transition-transform duration-300 ease-out"
            style={`--animation-delay: ${index * 0.2}s`}
          >
            <Card
              title={section.title}
              description={section.description}
              imageUrl={sectionImages[index]}
              linkUrl={section.linkUrl}
              isExternal={section.isExternal}
              type="about"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .group {
    animation: fadeInUp 0.8s ease-out forwards;
    animation-delay: var(--animation-delay);
    opacity: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .group {
      animation: none;
      opacity: 1;
    }
  }
</style>
