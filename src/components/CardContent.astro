---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	title: string;
	imageUrl?: ImageMetadata;
	description?: string;
	name?: string;
	jobTitle?: string;
	date?: string;
	type: "about" | "services" | "members" | "news";
	isExternal?: boolean;
}

const {
	title,
	imageUrl,
	description,
	name,
	jobTitle,
	date,
	type,
	isExternal = false,
} = Astro.props;
---

{type === "about" && (
	<div class="surface-panel overflow-hidden rounded-[1.9rem]">
		<div class="relative">
			{imageUrl && (
				<Image
					src={imageUrl}
					alt=""
					class="h-72 w-full object-cover md:h-80"
					widths={[480, 720, 1080]}
					sizes="(min-width: 768px) 50vw, 100vw"
				/>
			)}
			<div class="absolute inset-0 bg-gradient-to-t from-black/72 via-black/26 to-transparent"></div>
			<div class="absolute left-6 top-6">
				<span class="diamond-chip bg-white/92">企業情報</span>
			</div>
		</div>
		<div class="flex items-end justify-between gap-4 px-6 py-6 md:px-8">
			<div>
				<h3 class="text-2xl font-extrabold tracking-[-0.04em] text-brand-ink md:text-3xl">
					{title}
				</h3>
				{description && (
					<p class="mt-3 max-w-md text-sm leading-7 text-brand-ink-muted md:text-base">
						{description}
					</p>
				)}
			</div>
			<div class="flex h-12 w-12 items-center justify-center border border-brand-line bg-white text-brand-red">
				<span aria-hidden="true">↗</span>
				{isExternal && <span class="sr-only">（外部サイト）</span>}
			</div>
		</div>
	</div>
)}

{type === "services" && (
	<div class="surface-panel h-full rounded-[1.9rem] border-t-4 border-t-brand-red px-6 pb-6 pt-6 md:px-7">
		<div class="mb-5 flex items-center justify-between gap-4">
			<span class="diamond-chip bg-brand-panel">事業内容</span>
			<div class="h-8 w-8 rotate-45 border border-brand-line bg-brand-panel-strong"></div>
		</div>
		{imageUrl && (
			<div class="overflow-hidden rounded-[1.2rem]">
				<Image
					src={imageUrl}
					alt=""
					class="h-52 w-full object-cover transition duration-500 group-hover:scale-105"
					widths={[320, 480, 640, 800]}
					sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
				/>
			</div>
		)}
		<h3 class="mt-6 text-2xl font-extrabold tracking-[-0.04em] text-brand-ink">
			{title}
		</h3>
		{description && (
			<p class="mt-4 text-sm leading-7 text-brand-ink-muted md:text-base">
				{description}
			</p>
		)}
		<div class="mt-5">
			<slot />
		</div>
	</div>
)}

{type === "members" && (
	<div class="surface-panel overflow-hidden rounded-[1.9rem]">
		<div class="relative overflow-hidden bg-brand-sand">
			{imageUrl ? (
				<Image
					src={imageUrl}
					alt={name ? `${name}の写真` : `${title}の写真`}
					class="h-72 w-full object-cover transition duration-500 group-hover:scale-105 md:h-80"
					widths={[320, 480, 640, 800]}
					sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw"
					loading="lazy"
				/>
			) : (
				<div class="editorial-grid flex h-72 items-end justify-start bg-brand-panel-strong p-5 md:h-80">
					<div class="h-16 w-16 rotate-45 bg-brand-red"></div>
				</div>
			)}
			<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/72 via-black/30 to-transparent px-5 pb-5 pt-16">
				{jobTitle && (
					<p class="text-xs font-bold uppercase tracking-[0.24em] text-white/76">
						{jobTitle}
					</p>
				)}
				{name && (
					<h3 class="mt-2 text-xl font-extrabold tracking-[-0.04em] text-white">
						{name}
					</h3>
				)}
			</div>
		</div>
	</div>
)}

{type === "news" && (
	<div class="surface-panel rounded-[1.75rem] border-l-4 border-l-brand-red px-6 py-6 md:px-8">
		<div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
			<div class="max-w-2xl">
				{date && (
					<time
						datetime={date}
						class="text-xs font-bold uppercase tracking-[0.28em] text-brand-stone"
					>
						{date}
					</time>
				)}
				<h3 class="mt-3 text-2xl font-extrabold tracking-[-0.04em] text-brand-ink transition group-hover:text-brand-red">
					{title}
				</h3>
				{description && (
					<p class="mt-3 text-sm leading-7 text-brand-ink-muted md:text-base">
						{description}
					</p>
				)}
			</div>
			<div class="flex h-12 w-12 items-center justify-center self-start border border-brand-line bg-white text-brand-red">
				<span aria-hidden="true">→</span>
			</div>
		</div>
	</div>
)}
