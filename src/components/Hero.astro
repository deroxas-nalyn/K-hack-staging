---
import { Image } from "astro:assets";
import hero1 from "../assets/hero/hero01.jpg";
import hero2 from "../assets/hero/hero02.jpg";
import hero3 from "../assets/hero/hero03.jpg";

interface Props {
	title?: string;
	subtitle?: string;
}

const {
	title = "街を書き換える。",
	subtitle = "システム開発、地域DX支援、人材育成に取り組むIT企業です。",
} = Astro.props;

const heroHighlights = [
	"大手企業向けのシステム開発",
	"地域DXの実装支援",
	"次世代エンジニアの育成",
];

const heroStats = [
	{ value: "2023年", label: "設立" },
	{ value: "北海道釧路市", label: "本社所在地" },
	{ value: "開発・地域DX・人材育成", label: "事業領域" },
];

const stackedImages = [hero2, hero3];
---

<section class="relative overflow-hidden border-b border-black/8 pb-20">
	<div class="absolute inset-0 editorial-grid opacity-40"></div>
	<div class="site-shell relative z-10 grid gap-12 pt-10 md:grid-cols-[1.15fr_0.85fr] md:pt-14 lg:gap-16">
		<div class="max-w-3xl">
			<p class="brand-kicker mb-6">株式会社k-Hack</p>
			<h1 class="max-w-4xl text-5xl font-extrabold leading-[0.95] tracking-[-0.06em] text-brand-ink md:text-7xl">
				{title}
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-8 text-brand-ink-muted md:text-xl">
				{subtitle}
			</p>

			<div class="mt-8 flex flex-wrap gap-3">
				{
					heroHighlights.map((highlight) => (
						<span class="diamond-chip">{highlight}</span>
					))
				}
			</div>

			<div class="mt-10 flex flex-wrap gap-4">
				<a href="/contact" class="cta-primary">
					お問い合わせ
					<span aria-hidden="true">↗</span>
				</a>
				<a href="/#services" class="cta-secondary">
					事業内容を見る
				</a>
			</div>

			<div class="mt-12 grid gap-4 border-t border-black/10 pt-8 sm:grid-cols-3">
				{
					heroStats.map((stat) => (
						<div>
							<p class="text-xs font-bold uppercase tracking-[0.28em] text-brand-stone">
								{stat.label}
							</p>
							<p class="mt-2 text-2xl font-extrabold tracking-[-0.05em] text-brand-ink md:text-3xl">
								{stat.value}
							</p>
						</div>
					))
				}
			</div>
		</div>

		<div class="relative">
			<div class="surface-panel relative overflow-hidden rounded-[2rem] p-3">
				<div class="absolute right-6 top-6 h-24 w-24 rotate-45 border border-white/40 bg-brand-red/90"></div>
				<Image
					src={hero1}
					alt="株式会社k-Hackのチームとオフィスの様子"
					class="h-[26rem] w-full rounded-[1.4rem] object-cover md:h-[38rem]"
					loading="eager"
					decoding="async"
					sizes="(min-width: 1024px) 42vw, 100vw"
					widths={[640, 768, 1024, 1280]}
					quality={88}
				/>
				<div class="absolute inset-x-6 bottom-6 grid gap-4 md:grid-cols-2">
					{
						stackedImages.map((image) => (
							<div class="overflow-hidden rounded-[1.2rem] border border-white/40 bg-black/30 backdrop-blur-sm">
								<Image
									src={image}
									alt=""
									class="h-28 w-full object-cover opacity-90 md:h-32"
									loading="lazy"
									sizes="(min-width: 1024px) 18vw, 42vw"
									widths={[320, 480, 640]}
									quality={82}
								/>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
