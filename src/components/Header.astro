---
import Logo from "./icons/Logo.astro";
import MobileMenu from "./MobileMenu.astro";

const BASE = import.meta.env.BASE_URL;

const navLinks = [
	{ href: "${BASE}about/", text: "会社概要" },
	{ href: "${BASE}#services/", text: "事業内容" },
	{ href: "${BASE}members/", text: "メンバー" },
	{ href: "${BASE}news/", text: "ニュース" },
	{ href: "${BASE}contact/", text: "お問い合わせ" },
];


const actionButtons = [
	{
		href: "https://herp.careers/v1/khack/",
		text: "採用情報",
		isExternal: true,
	},
];

const getCurrentMarker = (href: string) => {
	const url = new URL(href, Astro.site ?? Astro.url);
	const normalizedPath = url.pathname.replace(/\/+$/, "") || "/";

	if (url.hash) {
		return undefined;
	}

	return normalizedPath === currentPath ? "page" : undefined;
};

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header
	id="main-header"
	class="fixed inset-x-0 top-0 z-50 border-b border-black/8 bg-[rgba(255,253,248,0.82)] backdrop-blur-xl"
	transition:persist
>
	<div class="site-shell flex min-h-[88px] items-center justify-between gap-6">
		<a
			href="/"
			class="flex items-center gap-4 rounded-sm focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2"
		>
			<Logo size={42} className="text-brand-ink" />
			<div class="hidden sm:block">
				<p class="text-[0.65rem] font-bold uppercase tracking-[0.34em] text-brand-stone">
					株式会社k-Hack
				</p>
				<p class="mt-1 text-lg font-extrabold tracking-[0.12em] text-brand-ink">
					K-HACK Inc.
				</p>
			</div>
			<span class="sr-only">株式会社k-Hack ホームページ</span>
		</a>

		<nav class="hidden items-center gap-8 md:flex" aria-label="メインナビゲーション">
			<div class="flex items-center gap-6 text-sm font-semibold tracking-[0.12em] text-brand-ink-muted">
				{
					navLinks.map((link) => (
						<a
							href={link.href}
							class="relative rounded-sm py-2 transition duration-200 hover:text-brand-red focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2"
							aria-current={getCurrentMarker(link.href)}
						>
							{link.text}
						</a>
					))
				}
			</div>
			<div class="flex items-center gap-4">
				{
					actionButtons.map((button) => (
						<a
							href={button.href}
							class="cta-primary text-[0.72rem]"
							aria-label={button.isExternal
								? `${button.text}（外部サイト）`
								: undefined}
						>
							{button.text}
							{button.isExternal && (
								<svg
									class="h-3.5 w-3.5"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
									/>
								</svg>
							)}
						</a>
					))
				}
			</div>
		</nav>

		<div class="md:hidden">
			<button
				data-menu-button
				type="button"
				aria-label="メニューを開く"
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="rounded-sm border border-black/10 bg-white/70 p-3 text-brand-ink transition hover:border-brand-red hover:text-brand-red focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2"
			>
				<svg
					data-icon="hamburger"
					class="h-5 w-5"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 6h16M4 12h16M4 18h16"
					/>
				</svg>
				<svg
					data-icon="close"
					class="hidden h-5 w-5"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"
					/>
				</svg>
			</button>
		</div>
	</div>

	<MobileMenu {navLinks} {actionButtons} />
</header>
